
@model Experiment_8.Models.Product

@{
    Layout = null;
}

<h2>Add New Product</h2>

@using (Html.BeginForm("Create", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <p>Product ID:</p>
    @Html.TextBoxFor(m => m.ProductId, new { required = "required" })

    <p>Product Name:</p>
    @Html.TextBoxFor(m => m.ProductName, new { required = "required" })

    <p>Quantity:</p>
    @Html.TextBoxFor(m => m.Quantity, new { type = "number", required = "required" })

    <p>Price:</p>
    @Html.TextBoxFor(m => m.Price, new { type = "number", step = "0.01", required = "required" })

    <br />
    <br />

    <input type="submit" value="Save Product" />
}

<br />
@Html.ActionLink("Back to Inventory", "Index")
